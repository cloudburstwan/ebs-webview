# Development Environment Configuration
# Use this for local testing with the mock API server

# Comma-separated hostnames allowed to access the dev server
VITE_ALLOWED_HOSTS=player.equestria.horse,stream.equestria.horse

# The display name for the streaming platform
VITE_APP_NAME=Equestrian Broadcast Service

# Base URL for the stream backend (Mock Server)
# VITE_STREAM_BASE_URL=http://localhost:9000
# VITE_STREAM_BASE_URL=http://localhost:8080
VITE_STREAM_BASE_URL=https://stream.equestria.horse

# Default stream to load
VITE_DEFAULT_STREAM=ebs

# Supported quality labels
VITE_SUPPORTED_QUALITIES=360p,720p,1080p

# The suffix appended to the base URL for stream access (default: 's')
VITE_STREAM_SUFFIX=s

# API Version path
VITE_API_VERSION=api/v1

# Filter withheld streams (true/false)
VITE_FILTER_STREAMS=false

# Show branded EBS logo as no-signal overlay (true/false)
VITE_BRANDED_OVERLAY=true

# Player Configuration
VITE_PLAYER_MAX_LIVE_SYNC_PLAYBACK_RATE=1.0
VITE_PLAYER_LIVE_SYNC_DURATION=6
